{
  "name": "hopper",
  "productName": "Hopper",
  "version": "2.6.0",
  "private": true,
  "description": "Hopper: the internal file manager of Dexterity Design Services Private Limited. Dual panes, a transfer queue, one-key zips, PDF and lot tools, and @mention file sharing over the office LAN with Zoho Cliq notifications.",
  "main": "out/main/index.js",
  "homepage": "https://vikramdex-ops.github.io/Hopper/",
  "repository": {
    "type": "git",
    "url": "https://github.com/vikramdex-ops/Hopper.git"
  },
  "bugs": {
    "url": "https://github.com/vikramdex-ops/Hopper/issues"
  },
  "author": {
    "name": "Dexterity Design Services Private Limited"
  },
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node tools/build-native.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --no-warnings \"tests/unit/*.test.mjs\"",
    "e2e": "node tests/e2e/run.mjs",
    "shots": "node tests/e2e/shots.mjs",
    "icons": "node tools/make-icon.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win --x64",
    "native": "node tools/build-native.mjs",
    "e2e:all": "node tests/e2e/run.mjs && node tests/e2e/lan.mjs && node tests/e2e/pubshare.mjs && node tests/e2e/pubshare-app.mjs && node tests/e2e/pubshare-staff.mjs && node tests/e2e/pubshare-create-page.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "exceljs": "4.4.0",
    "mammoth": "^1.8.0",
    "pdf-lib": "1.17.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "1.64.1",
    "svelte": "5.57.3",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  },
  "build": {
    "appId": "com.dexterity.hopper",
    "productName": "Hopper",
    "copyright": "Copyright © 2026 Dexterity Design Services Private Limited. All rights reserved.",
    "artifactName": "Hopper-${version}-win-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "vikramdex-ops",
        "repo": "Hopper",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "vendor/7zip",
        "to": "7zip"
      },
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "HopperShell.exe"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hopper",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "include": "build/installer.nsh"
    }
  }
}
