{
  "name": "xplorer2-modern",
  "productName": "Xplorer2 Modern",
  "version": "1.1.0",
  "description": "A modern, keyboard-first dual-pane file manager for Windows, macOS and Linux — tabs, folder tree, preview pane, scrap panes, search, duplicates, compare/sync and more.",
  "main": "electron/main.js",
  "homepage": "https://github.com/vikramdex-ops/Xplorer2",
  "repository": {
    "type": "git",
    "url": "https://github.com/vikramdex-ops/Xplorer2.git"
  },
  "bugs": {
    "url": "https://github.com/vikramdex-ops/Xplorer2/issues"
  },
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --remote-debugging-port=9222",
    "check": "node tools/check.mjs",
    "smoke": "node tools/smoke.mjs",
    "icons": "node tools/make-icon.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": {
    "name": "Asha",
    "email": "noreply@example.invalid",
    "url": "https://github.com/vikramdex-ops"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vikramdex.xplorer2",
    "productName": "Xplorer2 Modern",
    "copyright": "Copyright © 2026 Asha",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "!**/*.map",
      "!**/*.md"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xplorer2 Modern",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": ["AppImage", "deb"]
    }
  }
}
